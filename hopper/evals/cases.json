{
  "_about": "Hopper agent evals. mode_spec is the product definition of each Mode, written down independently of app/modes.py so a code change that drifts from the spec fails. trips are golden trip requests; intents are rider messages with the fields the Intent agent must extract.",

  "mode_spec": {
    "hustle": {"goal": "fastest", "max_walk_leg_mi": 0.4, "max_total_walk_mi": 0.8,
               "top_within_fastest_pct": 15},
    "broke":  {"goal": "budget", "max_walk_leg_mi": 1.5, "max_total_walk_mi": 2.5,
               "max_slowdown": 2.5, "ride_last_resort": true,
               "top_within_cheapest_usd": 0.5},
    "burn":   {"goal": "part transit / part workout", "max_walk_leg_mi": 2.0, "max_total_walk_mi": 3.0,
               "max_slowdown_vs_fastest_transit": 2.0, "needs_transit": true, "min_active_share": 0.4,
               "top_within_max_kcal_pct": 20}
  },

  "trips": [
    {"id": "ferry-to-painted-ladies-am", "origin": "ferry_building", "destination": "painted_ladies",
     "hour": 8, "weather": "clear"},
    {"id": "ferry-to-painted-ladies-rain", "origin": "ferry_building", "destination": "painted_ladies",
     "hour": 8, "weather": "rain", "expect": {"no_bikes": true}},
    {"id": "union-square-to-sfo", "origin": "union_square", "destination": "sfo",
     "hour": 17, "weather": "clear", "expect": {"broke_top_uses": ["bart"], "broke_top_no_ride": true}},
    {"id": "mission-to-coit-fog", "origin": "mission_16th", "destination": "coit_tower",
     "hour": 12, "weather": "fog"},
    {"id": "ocean-beach-to-salesforce", "origin": "ocean_beach", "destination": "salesforce_tower",
     "hour": 9, "weather": "clear", "expect": {"broke_top_no_ride": true}},
    {"id": "castro-to-giants-game", "origin": "castro", "destination": "oracle_park",
     "hour": 18, "weather": "clear", "event": true},
    {"id": "wharf-to-twin-peaks-flat", "origin": "fishermans_wharf", "destination": "twin_peaks",
     "hour": 14, "weather": "clear", "avoid_steep": true, "expect": {"no_steep_walks": true}},
    {"id": "caltrain-to-warriors-rain", "origin": "caltrain", "destination": "chase_center",
     "hour": 19, "weather": "rain", "event": true, "expect": {"no_bikes": true}},
    {"id": "nob-hill-to-dolores-under-5", "origin": "nob_hill", "destination": "dolores_park",
     "hour": 10, "weather": "clear", "max_cost": 5, "expect": {"max_cost": 5}},
    {"id": "ggp-to-fidi-commute", "origin": "golden_gate_park", "destination": "montgomery",
     "hour": 7, "weather": "clear"},
    {"id": "pier-39-to-lombard-short", "origin": "pier_39", "destination": "lombard_st",
     "hour": 15, "weather": "clear"},
    {"id": "presidio-to-civic-late", "origin": "presidio", "destination": "civic_center",
     "hour": 22, "weather": "clear"}
  ],

  "intents": [
    {"q": "from ferry building to coit tower",
     "expect": {"origin": "ferry_building", "destination": "coit_tower"}},
    {"q": "get me to the giants game by 6pm, cheap",
     "expect": {"destination": "oracle_park", "hour": 18, "event": true, "mode": "broke"}},
    {"q": "fastest way from union square to the airport",
     "expect": {"origin": "union_square", "destination": "sfo", "mode": "hustle"}},
    {"q": "from the mission to twin peaks, I want a workout",
     "expect": {"origin": "mission_16th", "destination": "twin_peaks", "mode": "burn"}},
    {"q": "bar hop from hayes valley to the mission tonight",
     "expect": {"origin": "hayes_valley", "mode": "barcrawl"}},
    {"q": "from castro to dolores park under $5",
     "expect": {"origin": "castro", "destination": "dolores_park", "max_cost": 5}},
    {"q": "take me to ocean beach, it's raining",
     "expect": {"destination": "ocean_beach", "weather": "rain"}},
    {"q": "from 500 folsom st to chase center",
     "expect": {"destination": "chase_center", "origin_text": "500 folsom st"}, "absent": ["origin"]},
    {"q": "from nob hill to fishermans wharf, avoid hills",
     "expect": {"origin": "nob_hill", "destination": "fishermans_wharf", "avoid_steep": true}},
    {"q": "from ggp to fidi, I'm late",
     "expect": {"origin": "golden_gate_park", "destination": "montgomery", "mode": "hustle"}},
    {"q": "from king's cross to big ben", "sf_context": false,
     "expect": {"origin_text": "king's cross", "destination_text": "big ben"}, "absent": ["origin", "destination"]},
    {"q": "from shibuya crossing to tokyo tower", "sf_context": false,
     "expect": {"destination_text": "tokyo tower"}, "absent": ["origin", "destination"]},
    {"q": "warriors game tonight from powell, leaving at 7pm", "llm_only": true,
     "expect": {"origin": "powell", "destination": "chase_center", "event": true, "hour": 19}},
    {"q": "I'm broke, need to get from the painted ladies over to the wharf", "llm_only": true,
     "expect": {"origin": "painted_ladies", "destination": "fishermans_wharf", "mode": "broke"}}
  ]
}
